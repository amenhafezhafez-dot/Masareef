{
  // ────────────────────────────────────────────────────────────────────────
  // الملف ده بيترفع على git — ممنوع تحط فيه أي سر (مفاتيح، باسوردات).
  // القيم المربوطة بالبيئة (الداتابيز، الدومينات) متحددة في:
  //   • التطوير : appsettings.Development.json
  //   • الإنتاج  : environment variables على السيرفر
  // ────────────────────────────────────────────────────────────────────────

  "ConnectionStrings": {
    // الإنتاج: environment variable باسم  ConnectionStrings__DefaultConnection
    "DefaultConnection": ""
  },

  "Jwt": {
    // ⚠️ المفتاح السري مش بيتحط هنا أبداً.
    // التطوير : dotnet user-secrets set "Jwt:Key" "<مفتاح عشوائي 32 حرف على الأقل>"
    // الإنتاج : environment variable باسم  Jwt__Key  (شرطتين سفليتين)
    "Issuer": "Masareef.Api",
    "Audience": "Masareef.Client",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },

  "Cors": {
    // دومينات الفرونت إند المسموح لها، مفصولة بفاصلة.
    // الإنتاج: environment variable باسم  Cors__Origins
    // لازم https:// في الإنتاج، وإلا كوكي الـ refresh مش هتشتغل.
    "Origins": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*"
}
